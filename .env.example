[TEMPLATE]
# Salin ke .env.local untuk pengembangan, atau isi di Vercel → Project → Settings → Environment Variables.
# Nilai berikut HANYA dipakai di sisi server (API route /api/pakasir/*). Jangan pakai awalan NEXT_PUBLIC_.
# Setelah menambah atau mengubah variabel di Vercel, WAJIB Redeploy: tanpa itu
# /api/pakasir/create masih membalas 503 dan tombol pembayaran tidak berfungsi.

# Kredensial proyek Pakasir (Detail Proyek di dashboard Pakasir).
PAKASIR_SLUG=
PAKASIR_API_KEY=

# Rahasia webhook Pakasir. Dipakai halaman sukses untuk menitipkan konfirmasi ke
# server bot memakai jalur aktivasi yang sama dengan webhook Pakasir.
PAKASIR_WEBHOOK_SECRET=

# Opsional — biarkan kosong untuk memakai nilai bawaan.
# PAKASIR_API_BASE=https://app.pakasir.com/api/v2
# PAKASIR_SUBSCRIPTION_AMOUNT=3000
# WABOT_WEBHOOK_URL=https://wabot.mhr.web.id
